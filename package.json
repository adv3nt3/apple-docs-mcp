{
  "name": "@adv3nt3/apple-docs-mcp",
  "version": "1.3.0",
  "description": "MCP server for Apple Developer Documentation - Search iOS/macOS/SwiftUI/UIKit docs, WWDC videos, Swift/Objective-C APIs & code examples in Claude, Cursor & AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "apple-docs-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.*.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adv3nt3/apple-docs-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/adv3nt3/apple-docs-mcp/issues"
  },
  "homepage": "https://github.com/adv3nt3/apple-docs-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && cp -r data dist/ && cp package.json dist/",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run test:ci",
    "release:patch": "npm version patch && git push origin main --tags && npm publish --provenance --access public",
    "release:minor": "npm version minor && git push origin main --tags && npm publish --provenance --access public",
    "release:major": "npm version major && git push origin main --tags && npm publish --provenance --access public"
  },
  "keywords": [
    "mcp",
    "apple",
    "developer-documentation",
    "ios",
    "macos",
    "swift",
    "objective-c",
    "api-search",
    "framework-documentation",
    "sample-code",
    "apple-apis"
  ],
  "author": "adv3nt3",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "jest": "^30.3.0",
    "jsdom": "^26.1.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
